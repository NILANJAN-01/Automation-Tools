# Optional settings. Copy to .env (git-ignored) to change them.
# The Gmail address and app password are entered with:  .\.venv\Scripts\python.exe main.py --setup
# (the password is stored in Windows Credential Manager, not in this file).

# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=     # only if you prefer a file over Credential Manager

# How far back the very first check looks, and the longest gap ever covered (e.g. after a holiday).
FIRST_RUN_LOOKBACK_DAYS=7
MAX_LOOKBACK_DAYS=7

# Days of job mails listed in the popup and on the summary page.
HISTORY_DAYS=14

# Minutes until the popup comes back after you close it with X.
REOPEN_MINUTES=2

# Popup theme: auto (follow Windows light/dark), light or dark.
THEME=auto
